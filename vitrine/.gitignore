# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Variáveis de ambiente.
# `*.local` acima já pegava .env.local, mas não .env nem .env.production —
# justamente os nomes onde uma senha costuma acabar. A regra abaixo ignora
# tudo (inclusive server/.env) e reabre só o modelo com placeholders.
.env
.env.*
!.env.example

# Imagens enviadas pelo painel quando a API roda fora do Docker.
.uploads

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Saída do teste de fumaça de renderização (npm run smoke)
.smoke

# Resto da hospedagem anterior na Vercel, se ainda existir na sua máquina.
.vercel
