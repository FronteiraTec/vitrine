# API rodando fora do Docker (npm run dev:api), com o banco do
# docker-compose.dev.yml. Copie para server/.env — que não vai para o git.
#
# As senhas são as mesmas do .env da raiz.
DATABASE_URL=postgres://authenticator:troque-esta-outra-senha@localhost:5432/vitrine
ADMIN_DATABASE_URL=postgres://vitrine:troque-esta-senha@localhost:5432/vitrine
APP_DB_PASSWORD=troque-esta-outra-senha
PORT=3000

# Sem SITE_URL, as URLs seguem o endereço da requisição (http://localhost:5173).
# SITE_URL=
