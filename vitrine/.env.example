# =============================================================================
# Configuração da Vitrine NA SUA MÁQUINA — modelo.
#
#   cp .env.example .env
#
# Este arquivo vai para o repositório com placeholders. O `.env` de verdade,
# com as senhas, NUNCA: ele já está no .gitignore.
#
# No servidor, o .env é outro — gerado pelo deploy/vps/instalar.sh, com senhas
# aleatórias que nunca saem da VPS (ver deploy/README.md).
#
# Senhas: use só letras e números (elas entram em URLs de conexão). Para gerar:
#   openssl rand -hex 24
# =============================================================================

# --- Obrigatórias ------------------------------------------------------------

# Dono do banco. Usado só pelo container `migrate`.
POSTGRES_PASSWORD=troque-esta-senha

# Senha do papel `authenticator`, com que a API conecta. Ele sozinho não lê
# nada: a cada requisição assume o papel de quem pediu, e o RLS decide.
APP_DB_PASSWORD=troque-esta-outra-senha

# Domínio público, sem barra no fim. Canônica, sitemaps, feed, robots.txt, URL
# das imagens enviadas e link do e-mail de senha. Mudou? `docker compose build
# web` — ele entra no build do React.
SITE_URL=https://vitrine.exemplo.edu.br

# --- Rede --------------------------------------------------------------------

# Porta em que o site atende: http://localhost:8080.
HTTP_PORT=8080
# 127.0.0.1 = só esta máquina. Porta publicada pelo Docker passa por cima do
# firewall; abra para a rede (0.0.0.0) só se souber por quê.
HTTP_BIND=127.0.0.1

# Proxies confiáveis à frente do Nginx, separados por vírgula. Sem isto, com
# um proxy no caminho, todo acesso parece vir dele (a audiência mostraria um
# país só). Vazio quando o Nginx recebe o visitante direto.
TRUSTED_PROXIES=
# Cabeçalho com o IP real. Cloudflare: CF-Connecting-IP.
REAL_IP_HEADER=X-Forwarded-For

# Cookie de sessão só por HTTPS. Vazio = segue o protocolo de SITE_URL.
COOKIE_SECURE=

# Fuso dos dias do relatório de audiência e dos logs.
TZ=America/Sao_Paulo

# --- E-mail (opcional) -------------------------------------------------------
# Só o "esqueci minha senha" usa. Sem SMTP, a tela avisa e um administrador
# define a senha nova pela tela de Usuários.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- Localização da audiência (opcional) -------------------------------------
# Conta gratuita em https://www.maxmind.com/en/geolite2/signup. Depois:
#   docker compose --profile geoip up -d
GEOIP_ACCOUNT_ID=
GEOIP_LICENSE_KEY=
